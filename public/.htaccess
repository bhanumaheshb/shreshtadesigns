Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<Files "consultation.php">
  LimitRequestBody 20000
</Files>

<FilesMatch "(?i)^\\.|\\.(?:env|ini|log|lock|map|sql|bak|dist|swp)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L]

  # Limit canonical redirects to the configured public domain and its www alias.
  RewriteCond %{HTTP_HOST} ^www\.shreshtadesigns\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^shreshtadesigns\.com$ [NC]
  RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteRule ^ https://shreshtadesigns.com%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{THE_REQUEST} "[[:space:]]/+[^?[:space:]]*index[.]html(?:[?[:space:]])" [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'"
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "__STATIC_HTML_CACHE__"
  </Files>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(?:js|css|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/plain application/json application/javascript application/xml
</IfModule>
